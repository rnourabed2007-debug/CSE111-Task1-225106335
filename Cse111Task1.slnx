using System;

namespace Cse111Task1
{
    class Student
    {
        public int Id;
        public Student Next;

        public Student(int id)
        {
            Id = id;
            Next = null;
        }
    }

    class StudentList
    {
        public Student First;
        public Student Last;
        public int Count;

        public StudentList()
        {
            First = null;
            Last = null;
            Count = 0;
        }

        public void AddFront(int id)
        {
            Student newStudent = new Student(id);

            if (First == null)
            {
                First = newStudent;
                Last = newStudent;
            }
            else
            {
                newStudent.Next = First;
                First = newStudent;
            }

            Count++;
        }

        public void AddEnd(int id)
        {
            Student newStudent = new Student(id);

            if (First == null)
            {
                First = newStudent;
                Last = newStudent;
            }
            else
            {
                Last.Next = newStudent;
                Last = newStudent;
            }

            Count++;
        }

        public bool Remove(int id)
        {
            if (First == null)
                return false;

            if (First.Id == id)
            {
                First = First.Next;
                Count--;

                if (First == null)
                    Last = null;

                return true;
            }

            Student current = First;

            while (current.Next != null)
            {
                if (current.Next.Id == id)
                {
                    if (current.Next == Last)
                        Last = current;

                    current.Next = current.Next.Next;
                    Count--;
                    return true;
                }

                current = current.Next;
            }

            return false;
        }

        public void Reverse()
        {
            Student previous = null;
            Student current = First;
            Last = First;

            while (current != null)
            {
                Student next = current.Next;
                current.Next = previous;
                previous = current;
                current = next;
            }

            First = previous;
        }

        public void Print()
        {
            Student current = First;

            while (current != null)
            {
                Console.Write(current.Id + " ");
                current = current.Next;
            }

            Console.WriteLine();
        }
    }

    class Program
    {
        static void Main()
        {
            StudentList line = new StudentList();

            line.AddFront(20);
            line.AddFront(10);
            line.AddEnd(30);
            line.AddEnd(40);
            line.Print();
            line.Reverse();
            line.Print();
            line.Remove(20);
            line.Print();
            Console.WriteLine("First: " + line.First.Id);
            Console.WriteLine("Last: " + line.Last.Id);
            Console.WriteLine("Count: " + line.Count);
        }
    }
}
